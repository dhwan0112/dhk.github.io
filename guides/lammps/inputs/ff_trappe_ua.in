# =============================================================
# ff_trappe_ua.in : TraPPE-UA 힘장 설정 (6 atom types)
# =============================================================
# Reference (alcohol): Chen, Potoff, Siepmann,
#                     J. Phys. Chem. B 105, 3093 (2001). doi:10.1021/jp003882x
# Reference (aromatic CH): Wick, Martin, Siepmann,
#                     J. Phys. Chem. B 104, 8008 (2000). doi:10.1021/jp001044x
# Cu LJ:               Heinz et al., JPCC 112, 17281 (2008). doi:10.1021/jp801931d
#
# 사용 순서 : common.in -> read_data -> kspace_*.in -> ff_trappe_ua.in
#
# Atom type mapping (trappe.data 와 일치해야 함):
#   1  CH_aro  (aromatic CH united-atom, benzene site)
#   2  CH3     (methyl united-atom)
#   3  CH2     (alpha CH2 united-atom)
#   4  O       (hydroxyl O)
#   5  H       (hydroxyl H)
#   6  Cu      (slab atom)
# -------------------------------------------------------------

# -- Pair modifier --
pair_modify     mix arithmetic tail no   # Lorentz-Berthelot, 슬랩이므로 tail 금지

# -- 결합/각도/이면각 스타일 --
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls                     # TraPPE 이면각도 cosine 급수: c_n = K_n / 2
# 예: CH3-CH2-O-H (Chen 2001) c1, c2, c3 = 209.82, -29.17, 187.93 K
#     -> K1 K2 K3 = 0.8339 -0.1159 0.7469 kcal/mol
# 벤젠 UA 고리는 이면각 대신 fix rigid/small 로 묶는 편이 낫다 (fix shake 는 고리를 못 묶는다).
#
# bond/angle/dihedral 계수는 trappe.data 의 Coeffs 섹션 또는 별도 *_coeff 줄로 준다.

# -- 1-4 스케일링 (TraPPE 표준: 완전 제외) --
special_bonds   lj/coul 0.0 0.0 0.0

# =============================================================
# Pair coefficients
# epsilon [kcal/mol] = (epsilon/k_B [K]) x 1.987 x 10^-3
# =============================================================
# Aromatic CH (Wick 2000): epsilon/k_B = 50.5 K, sigma = 3.695 A
pair_coeff   1   1   0.10034  3.695    # CH_aro

# Alcohol (Chen 2001):
pair_coeff   2   2   0.19472  3.750    # CH3   (98.0  K)
pair_coeff   3   3   0.09140  3.950    # CH2   (46.0  K)
pair_coeff   4   4   0.18480  3.020    # O     (93.0  K)
pair_coeff   5   5   0.00000  0.000    # H     (no LJ)

# Cu (Heinz 2008, 12-6): epsilon 4.72 kcal/mol, sigma 2.330 A (r0 = 2.616 A 는 sigma 가 아님)
pair_coeff   6   6   4.72000  2.330    # Cu

# Cu-organic cross terms 은 mix arithmetic 으로 자동 생성됨.
