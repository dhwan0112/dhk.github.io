# =============================================================
# ff_opls_aa.in : OPLS-AA 힘장 설정 (12 atom types)
# =============================================================
# Reference: Jorgensen, Maxwell, Tirado-Rives,
#            J. Am. Chem. Soc. 118, 11225 (1996). doi:10.1021/ja9621760
#
# 사용 순서 : common.in -> read_data -> kspace_*.in -> ff_opls_aa.in
# (pair_style 은 kspace_*.in 에서 미리 설정되어 있어야 한다.)
#
# 아래 계수는 UROPS run 의 ff_params.in 을 그대로 옮긴 것이다
# (/files/blog/pppm-vs-msm/opls.data 와 같이 쓰면 그대로 돌아간다).
# OPLS-AA 표준값과 다른 항목은 줄 끝에 [표준: ...] 으로 적었다.
#
# Atom type mapping (opls.data Masses 섹션):
#   1  CA   benzene C            q = -0.115
#   2  HA   benzene H            q = +0.115
#   3  C00  ethanol CH3 의 C     q = -0.128   [표준 -0.180]
#   4  C01  ethanol CH2 의 C     q = +0.128   [표준 +0.145]
#   5  O02  ethanol O            q = -0.728   [표준 -0.683]
#   6-8     CH3 의 H             q = +0.0592  [표준 +0.060]
#   9-10    CH2 의 H             q = +0.0592  [표준 +0.060]
#   11      hydroxyl H           q = +0.432   [표준 +0.418]
#   12 Cu   slab atom            q = 0
# 전하는 opls.data 의 Atoms 섹션에 이미 들어 있다.
# -------------------------------------------------------------

pair_modify     mix geometric tail no    # OPLS-AA: 기하 평균, 슬랩에서 tail 보정 금지

bond_style      harmonic
angle_style     harmonic
dihedral_style  opls                     # OPLS 4-cosine
improper_style  harmonic

special_bonds   lj/coul 0.0 0.0 0.5      # OPLS 1-4 스케일링

# -- Pair coefficients (epsilon kcal/mol, sigma A) --
pair_coeff   1   1   0.070   3.550   # CA
pair_coeff   2   2   0.030   2.420   # HA
pair_coeff   3   3   0.066   3.500   # C00 (CH3)
pair_coeff   4   4   0.066   3.500   # C01 (CH2)
pair_coeff   5   5   0.170   3.070   # O   [표준 sigma 3.120]
pair_coeff   6   6   0.030   2.500   # H on CH3
pair_coeff   7   7   0.030   2.500
pair_coeff   8   8   0.030   2.500
pair_coeff   9   9   0.030   2.500   # H on CH2
pair_coeff  10  10   0.030   2.500
pair_coeff  11  11   0.000   0.000   # hydroxyl H (no LJ)

# Cu-Cu: Cu 는 전부 고정이고 아래 neigh_modify exclude 로 Cu-Cu 쌍을 빼므로
# 이 값은 계산에 쓰이지 않는다. 형식상 필요한 줄이다.
# (Heinz 2008 12-6 Cu: epsilon 4.72 kcal/mol, sigma 2.330 A, r0 = 2.616 A)
pair_coeff  12  12   4.720   2.330
neigh_modify    exclude type 12 12   # Cu 전하가 0 이라 kspace 경고는 무시해도 된다

# Cu-organic: UROPS run 에서 명시적으로 준 값.
# epsilon 은 Cu 쪽 epsilon 을 약 0.005 kcal/mol 로 두고 기하 평균한 것과 같다.
# Heinz 2008 값(4.72)을 기하 평균하면 CA-Cu 는 0.575 kcal/mol 로 약 30배 크다.
pair_coeff   1  12   0.01870   2.991
pair_coeff   2  12   0.01220   2.477
pair_coeff   3  12   0.01820   2.973
pair_coeff   4  12   0.01820   2.973
pair_coeff   5  12   0.02920   2.789
pair_coeff   6  12   0.01220   2.512
pair_coeff   7  12   0.01220   2.512
pair_coeff   8  12   0.01220   2.512
pair_coeff   9  12   0.01220   2.512
pair_coeff  10  12   0.01220   2.512
pair_coeff  11  12   0.00000   0.000

# -- Bonds (K kcal/mol/A^2, r0 A) --
bond_coeff   1  469.0  1.400    # CA-CA
bond_coeff   2  340.0  1.080    # CA-HA   [표준 367.0]
bond_coeff   3  268.0  1.529    # C00-C01
bond_coeff   4  340.0  1.090    # C01-H
bond_coeff   5  340.0  1.090    # C00-H
bond_coeff   6  340.0  1.090    # C00-H
bond_coeff   7  320.0  1.410    # C01-O
bond_coeff   8  553.0  0.945    # O-H
bond_coeff   9  340.0  1.090    # C00-H
bond_coeff  10  340.0  1.090    # C01-H

# -- Angles (K kcal/mol/rad^2, theta0 deg) --
angle_coeff   1  63.0  120.0    # CA-CA-CA
angle_coeff   2  35.0  120.0    # CA-CA-HA
angle_coeff   3  50.0  109.5    # C00-C01-O
angle_coeff   4  37.5  109.5    # C00-C01-H   [표준 37.5 110.7]
angle_coeff   5  50.0  109.5    # C00-C01-H   [표준 37.5 110.7]
angle_coeff   6  35.0  107.8    # C01-C00-H   [표준 37.5 110.7]
angle_coeff   7  33.0  109.5    # C01-C00-H   [표준 37.5 110.7]
angle_coeff   8  35.0  120.0    # C01-C00-H   [표준 37.5 110.7]
angle_coeff   9  63.0  120.0    # C01-O-H     [표준 55.0 108.5]
angle_coeff  10  33.0  109.5    # O-C01-H     [표준 35.0 109.5]
angle_coeff  11  37.5  109.5    # H-C00-H     [표준 33.0 107.8]
angle_coeff  12  37.5  109.5    # H-C00-H     [표준 33.0 107.8]
angle_coeff  13  50.0  109.5    # H-C00-H     [표준 33.0 107.8]
angle_coeff  14  35.0  107.8    # H-C01-O     [표준 35.0 109.5]
angle_coeff  15  33.0  109.5    # H-C01-H     [표준 33.0 107.8]

# -- Dihedrals (K1 K2 K3 K4, kcal/mol) --
dihedral_coeff   1  0.000  0.000  2.935  0.000   # CA-CA-CA-CA  [표준 0 7.250 0 0]
dihedral_coeff   2  0.000  0.000  0.000  0.000   # CA-CA-CA-HA  [표준 0 7.250 0 0]
dihedral_coeff   3  0.000  0.000  0.000  0.000   # HA-CA-CA-CA  [표준 0 7.250 0 0]
dihedral_coeff   4  0.000  0.000  0.000  0.000   # HA-CA-CA-HA  [표준 0 7.250 0 0]
dihedral_coeff   5  0.161 -0.038  0.284  0.000   # C-C-O-H      [표준 -0.356 -0.174 0.492 0]
dihedral_coeff   6  0.000  0.000  0.000  0.000   # H-C-C-O      [표준 0 0 0.468 0]
dihedral_coeff   7  0.000  0.000  0.000  0.000   # H-C-C-H      [표준 0 0 0.300 0]
dihedral_coeff   8  0.000  0.000  2.935  0.000   # H-C-C-H      [표준 0 0 0.300 0]
dihedral_coeff   9  0.000  0.000  0.000  0.000   # H-C-C-O      [표준 0 0 0.468 0]
dihedral_coeff  10  0.000  0.000  0.000  0.000   # H-C-C-H      [표준 0 0 0.300 0]
dihedral_coeff  11  0.000  0.000  0.000  0.000   # H-C-C-H      [표준 0 0 0.300 0]
dihedral_coeff  12  0.000  0.000  0.000  0.000   # H-C-C-O      [표준 0 0 0.468 0]
dihedral_coeff  13  0.000  0.000  0.000  0.000   # H-C-C-H      [표준 0 0 0.300 0]
dihedral_coeff  14  0.000  0.000  0.000  0.000   # H-C-C-H      [표준 0 0 0.300 0]
dihedral_coeff  15  0.000  0.000  0.000  0.000   # H-C-O-H      [표준 0 0 0.450 0]
dihedral_coeff  16  0.000  0.000  0.000  0.000   # H-C-O-H      [표준 0 0 0.450 0]

improper_coeff   1  10.5  180.0  # benzene 평면성
