# =============================================================
# 02_min.in : Stage 2 — Energy minimization
# =============================================================
# 목적: 국소 최소 에너지 배치로 정렬. Soft relaxation 후에도
#       남아있는 미세한 비물리적 응력을 제거한다.
# 방법: Conjugate gradient + line search
# 입력: stage1.restart
# 출력: stage2.restart
# -------------------------------------------------------------

# ---- (1) 공통 설정 ----
include         common.in

# ---- (2) Stage 1 결과 읽기 ----
read_restart    stage1.restart

# ---- (3) 정전기 + 힘장 재선언 (restart 후 권장) ----
include         kspace_pppm.in
include         ff_opls_aa.in

# ---- (4) 그룹 재정의 ----
group           cu       type 12
group           organic  subtract all cu

# ---- (5) 슬랩 벽 ----
fix             wall_top organic wall/lj93 zhi EDGE 0.1 3.0 10.0 units box

# ---- (6) Cu 슬랩 고정 ----
fix             freeze_cu cu setforce 0.0 0.0 0.0

# ---- (7) 출력 설정 ----
thermo          50
thermo_style    custom step temp pe ke etotal press fmax fnorm

# ---- (8) Minimization ----
# 알고리즘 : conjugate gradient
# 종료 조건: etol=1e-6, ftol=1e-6 kcal/mol/Å
# 최대 반복: 10000, 최대 force eval: 100000
min_style       cg
minimize        1.0e-6 1.0e-6 10000 100000

# ---- (9) 결과 저장 ----
write_restart   stage2.restart
