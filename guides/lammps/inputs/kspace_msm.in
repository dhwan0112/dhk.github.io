# =============================================================
# kspace_msm.in : MSM 정전기 + 단거리 pair_style 설정
# =============================================================
# Reference: Hardy, Stone, Schulten,
#            Parallel Comput. 35, 164 (2009). doi:10.1016/j.parco.2008.12.005
#
# MSM 은 격자 기반 멀티그리드 방법으로 FFT 를 사용하지 않으므로
# 비주기 z 경계를 별도 보정 없이 받는다.
# -------------------------------------------------------------

# -- Pair style (MSM 전용 변종) --
# MSM 은 실공간 항도 MSM 분할 함수를 써야 하므로 coul/long 이 아니라 coul/msm 이다.
pair_style      lj/cut/coul/msm 12.0

# -- K-space 스타일 --
kspace_style    msm 1.0e-4

# 슬랩 보정은 PPPM/Ewald 전용이다. MSM 에서는 kspace_modify slab 을 쓰지 않는다.

# pressure/scalar 는 MSM 전용 키워드다. 기본값 no 에서만 압력 텐서와
# 원자별 virial(compute stress/atom) 이 나온다. 명시적으로 적어 둔다.
kspace_modify   pressure/scalar no
