# =============================================================
# common.in : 모든 stage 공통 설정
# =============================================================
# 본 파일은 단위계, 원자 스타일, 통신 설정만 정의한다.
# 힘장과 정전기 설정은 별도 include 파일에서 불러온다.
# 데이터 파일 (opls.data / trappe.data) 도 별도 stage 파일에서 read_data 한다.
# -------------------------------------------------------------

units           real        # kcal/mol, Å, fs, K
atom_style      full        # id, mol-id, type, q, x, y, z
boundary        p p f       # x, y 주기, z 슬랩 (벽 + 진공)

# -- Neighbor list --
# 슬랩에서 분자가 z 방향으로 비균질하게 분포하므로 skin 을 약간 늘림.
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 5000 page 50000

# -- 통신 cutoff --
# Bond atoms missing 오류 방지. force cutoff (~12 Å) 의 1.2~1.3 배 권장.
comm_modify     mode single cutoff 14.0 vel yes

# -- Processor 분할 --
# 슬랩 시스템에서는 z 분할이 비효율적이므로 xy 평면에서만 분할한다.
processors      * * 1
