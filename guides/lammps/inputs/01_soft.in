# =============================================================
# 01_soft.in : Stage 1 — Soft relaxation (fix nve/limit)
# =============================================================
# 목적: 초기 좌표의 미세한 중첩과 비정상 결합을 해소.
# 방법: 한 시간 스텝당 최대 변위를 제한하여 (nve/limit) 큰 힘이
#       비현실적 가속을 만들지 않도록 한다.
# 입력: opls.data 또는 trappe.data
# 출력: stage1.restart
# -------------------------------------------------------------

# ---- (1) 공통 설정 ----
include         common.in

# ---- (2) 시스템 읽기 ----
# 프레임워크에 따라 한 줄만 골라서 사용
read_data       ../opls.data
# read_data     ../trappe.data

# ---- (3) 정전기 + 힘장 (프레임워크별로 두 줄만 변경) ----
include         kspace_pppm.in        # 또는 kspace_msm.in
include         ff_opls_aa.in         # 또는 ff_trappe_ua.in

# ---- (4) 그룹 정의 ----
# Cu 슬랩의 atom type 번호 확인 후 수정
# OPLS-AA : Cu = type 12
# TraPPE-UA : Cu = type 6
group           cu       type 12
group           organic  subtract all cu

# ---- (5) 슬랩 상단 벽 (LJ 9-3) ----
# 진공 영역으로 분자가 튀어나가지 못하게 약한 반발 벽 설치.
# epsilon=0.1 kcal/mol, sigma=3.0 A, cutoff=10 A
fix             wall_top organic wall/lj93 zhi EDGE 0.1 3.0 10.0 units box

# ---- (6) Cu 슬랩 고정 ----
# Stage 1 에서는 Cu 를 완전 정지 (force = 0)
fix             freeze_cu cu setforce 0.0 0.0 0.0

# ---- (7) 적분 설정 ----
# 한 스텝당 최대 변위 0.05 Å
timestep        0.5
fix             relax organic nve/limit 0.05

# ---- (8) 약한 열욕 (저온) ----
# 매우 낮은 온도에서 시작하여 폭주 방지
fix             thermo organic langevin 0.1 0.1 100.0 87287

# ---- (9) 출력 설정 ----
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# ---- (10) 실행 ----
# 50 ps soft relaxation
run             100000

# ---- (11) 결과 저장 ----
write_restart   stage1.restart
