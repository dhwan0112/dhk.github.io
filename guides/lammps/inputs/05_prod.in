# =============================================================
# 05_prod.in : Stage 5 — Production run with on-the-fly analysis
# =============================================================
# 목적: 통계 평균을 얻기 위한 본 생산 시뮬레이션.
#       궤적과 응력 텐서, RDF, 밀도 프로파일을 저장한다.
#
# 권장 길이 : 5 ~ 10 ns (TraPPE) 또는 10 ~ 20 ns (OPLS-AA)
#
# 입력: stage4.restart
# 출력: stage5.restart, dump.lammpstrj, profile.*.dat, rdf.dat
# -------------------------------------------------------------

include         common.in
read_restart    stage4.restart

include         kspace_pppm.in
include         ff_opls_aa.in

# ---- 그룹 정의 (분석용으로 더 세분화) ----
group           cu        type 12
group           organic   subtract all cu
# 분자 종류별 그룹은 atom type 으로 정의
# OPLS-AA 가정:  벤젠 = type 1,2 / 에탄올 = type 3,4,5,6,7,8
group           benzene   type 1 2
group           ethanol   type 3 4 5 6 7 8

fix             wall_top organic wall/lj93 zhi EDGE 0.1 3.0 10.0 units box
fix             freeze_cu cu setforce 0.0 0.0 0.0

# ---- 적분 ----
timestep        0.5
fix             thermo organic nvt temp 300.0 300.0 100.0

# ---- (A) 궤적 저장 ----
dump            traj all custom 1000 dump.lammpstrj id mol type x y z vx vy vz
dump_modify     traj sort id

# ---- (B) Z 방향 밀도 프로파일 ----
# 슬랩 표면 (z = z_Cu_top) 부터 진공 영역까지 0.5 Å 간격
compute         zchunks all chunk/atom bin/1d z lower 0.5 units box
fix             dens_b benzene  ave/chunk 100 50 5000 zchunks density/mass file profile_benzene.dat
fix             dens_e ethanol  ave/chunk 100 50 5000 zchunks density/mass file profile_ethanol.dat

# ---- (C) 방사 분포 함수 (RDF) ----
# Cu-C(benzene), Cu-O(ethanol) 두 쌍 (OPLS-AA 타입 기준)
compute         myrdf all rdf 200 12 1 12 7
fix             rdf_save all ave/time 100 50 5000 c_myrdf[*] file rdf.dat mode vector

# ---- (D) 응력 텐서 (Irving-Kirkwood 용) ----
compute         stress_per all stress/atom NULL pair bond angle dihedral
compute         stress_chunk all chunk/atom bin/1d z lower 0.5 units box
fix             stress_save all ave/chunk 100 50 5000 stress_chunk &
                c_stress_per[1] c_stress_per[2] c_stress_per[3] &
                c_stress_per[4] c_stress_per[5] c_stress_per[6] &
                file stress_profile.dat

# ---- (E) 흡착 에너지 (분자별 표면 인력) ----
# Cu - benzene, Cu - ethanol 그룹간 상호작용 에너지
compute         e_cb cu group/group benzene
compute         e_ce cu group/group ethanol

# ---- (F) Thermo 출력 ----
thermo          500
thermo_style    custom step temp pe ke etotal press density c_e_cb c_e_ce
thermo_modify   flush yes

# ---- (G) 실행 (예: 10 ns) ----
run             20000000

# ---- 결과 저장 ----
write_restart   stage5.restart
write_data      final.data
