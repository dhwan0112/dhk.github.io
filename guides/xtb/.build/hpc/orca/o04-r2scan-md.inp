# 100 fs of the same MD at r2SCAN-3c, to compare the cost per step with xTB
! r2SCAN-3c MD CPCM(water)
%pal nprocs 8 end
%maxcore 1500
%md
  Timestep 0.5_fs
  Initvel 300_K
  Thermostat NHC 300_K Timecon 50.0_fs
  Dump Position Stride 1 Filename "o04-r2scan-md.traj.xyz"
  Run 200
end
* xyzfile 0 1 ../o02-r2scan-opt-freq/o02-r2scan-opt-freq.xyz
