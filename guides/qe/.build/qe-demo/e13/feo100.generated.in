&CONTROL
  nstep = 25
   calculation      = 'relax'
   tprnfor          = .true.
   outdir           = './tmp/'
   prefix           = 'feo100'
   forc_conv_thr    = 0.0001
   pseudo_dir       = './pseudo/'
   tefield          = .true.
   dipfield         = .true.
/
&SYSTEM
   ecutwfc          = 70
   ecutrho          = 700
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'mv'
   edir             = 3
   emaxpos          = 0.9
   eopreg           = 0.05
   eamp             = 0.0
   ntyp             = 2
   nat              = 8
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-08
   mixing_mode      = 'local-TF'
   mixing_beta      = 0.2
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
/
&FCP
/
&RISM
/
