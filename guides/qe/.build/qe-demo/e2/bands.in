&control
  calculation='bands', prefix='si', outdir='./out', pseudo_dir='../pseudo'
/
&system
  ibrav=2, celldm(1)=10.26, nat=2, ntyp=1, ecutwfc=40, ecutrho=320, nbnd=8
/
