&control
  calculation='nscf', prefix='si', outdir='./out', pseudo_dir='../pseudo'
/
&system
  ibrav=2, celldm(1)=10.26, nat=2, ntyp=1, ecutwfc=40, ecutrho=320, occupations='tetrahedra'
/
&electrons
  conv_thr=1.0d-8
/
