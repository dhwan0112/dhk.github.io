&CONTROL
  calculation = 'scf'
  prefix      = 'fe'
  outdir      = './tmp/'
  pseudo_dir  = './pseudo/'
  verbosity   = 'high'
/
&SYSTEM
  ibrav       = 3
  celldm(1)   = 5.42
  nat         = 1
  ntyp        = 1
  ecutwfc     = 70
  ecutrho     = 700
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.02
  nspin       = 2
  starting_magnetization(1) = 0.7
/
&ELECTRONS
  conv_thr         = 1.0d-8
  mixing_beta      = 0.3
  mixing_mode      = 'local-TF'
  electron_maxstep = 200
/

ATOMIC_SPECIES
  Fe  55.845  Fe.pbe-spn-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS (alat)
  Fe  0.00  0.00  0.00

K_POINTS (automatic)
  16 16 16  0 0 0
