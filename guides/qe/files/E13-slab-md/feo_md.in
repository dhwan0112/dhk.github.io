! Born-Oppenheimer MD. ML 퍼텐셜 학습 데이터 샘플링의 출발점.
! dt 는 Rydberg 원자단위: 20.0 a.u. = 0.968 fs
&CONTROL
  calculation = 'md'
  prefix      = 'feo_md'
  outdir      = './tmp/'
  pseudo_dir  = './pseudo/'
  nstep       = 2000
  dt          = 20.0
  tprnfor     = .true.
  tstress     = .false.      ! nosym+U(ortho-atomic) 응력은 stres_hub 에러 (QE 7.5 실측)
  disk_io     = 'none'
/
&SYSTEM
  ibrav       = 0
  celldm(1)   = 8.18
  nat         = 4
  ntyp        = 3
  ecutwfc     = 70
  ecutrho     = 700
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.01
  nspin       = 2
  starting_magnetization(1) =  0.6
  starting_magnetization(2) = -0.6
  starting_magnetization(3) =  0.0
  nosym       = .true.       ! MD 필수 — 열운동이 초기 대칭을 깨면 checkallsym 에러
/
&ELECTRONS
  conv_thr    = 1.0d-6       ! BOMD 데모 기준. nosym+U 는 1.0d-8 도달이 어렵다 (실측)
  mixing_beta = 0.2
  mixing_mode = 'local-TF'
  electron_maxstep = 300
  mixing_fixed_ns  = 30      ! nosym+U 는 ns 동결 없이는 SCF 가 정체한다 (실측)
/
&IONS
  ion_dynamics    = 'verlet'
  ion_temperature = 'svr'
  tempw           = 300.0
  nraise          = 100
/

ATOMIC_SPECIES
  Fe1  55.845  Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
  Fe2  55.845  Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
  O    15.999  O.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS (alat)
  0.5  0.5  1.0
  0.5  1.0  0.5
  1.0  0.5  0.5

ATOMIC_POSITIONS (crystal)
  Fe1  0.00  0.00  0.00
  Fe2  0.50  0.50  0.50
  O    0.25  0.25  0.25
  O    0.75  0.75  0.75

K_POINTS (automatic)
  4 4 4  0 0 0

HUBBARD (ortho-atomic)
U Fe1-3d 4.6
U Fe2-3d 4.6
