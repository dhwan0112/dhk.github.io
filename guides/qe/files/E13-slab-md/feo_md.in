! Born-Oppenheimer MD: the starting point for sampling ML training data.
! dt is in Rydberg atomic units: 20.0 a.u. = 0.968 fs
&CONTROL
  calculation = 'md'
  prefix      = 'feo_md'
  outdir      = './tmp/'
  pseudo_dir  = './pseudo/'
  nstep       = 2000
  dt          = 20.0
  tprnfor     = .true.
  tstress     = .false.      ! Hubbard stress dies with stres_hub under nosym+U (measured on QE 7.5)
  disk_io     = 'none'
/
&SYSTEM
  ibrav       = 0
  celldm(1)   = 8.18
  nat         = 4
  ntyp        = 3
  ecutwfc     = 70
  ecutrho     = 700
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.01
  nspin       = 2
  starting_magnetization(1) =  0.6
  starting_magnetization(2) = -0.6
  starting_magnetization(3) =  0.0
  nosym       = .true.       ! mandatory for MD: thermal motion breaks the initial symmetry (checkallsym)
/
&ELECTRONS
  conv_thr    = 1.0d-6       ! BOMD-level threshold; nosym+U struggles below this (measured)
  mixing_beta = 0.2
  mixing_mode = 'local-TF'
  electron_maxstep = 300
  mixing_fixed_ns  = 30      ! nosym+U stalls without freezing ns first (measured)
/
&IONS
  ion_dynamics    = 'verlet'
  ion_temperature = 'svr'
  tempw           = 300.0
  nraise          = 100
/

ATOMIC_SPECIES
  Fe1  55.845  Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
  Fe2  55.845  Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
  O    15.999  O.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS (alat)
  0.5  0.5  1.0
  0.5  1.0  0.5
  1.0  0.5  0.5

ATOMIC_POSITIONS (crystal)
  Fe1  0.00  0.00  0.00
  Fe2  0.50  0.50  0.50
  O    0.25  0.25  0.25
  O    0.75  0.75  0.75

K_POINTS (automatic)
  4 4 4  0 0 0

HUBBARD (ortho-atomic)
U Fe1-3d 4.6
U Fe2-3d 4.6
